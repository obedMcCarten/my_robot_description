<?xml version="1.0"?>
<robot name="mi_brazo_5gdl" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Incluir el archivo de inercias -->
<xacro:include filename="$(find my_robot_description)/urdf/inertia_macros.xacro"/>
    <!-- Materiales -->
    <material name="blue"><color rgba="0 0 0.8 1"/></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

    <!-- Mundo / Base fija (Para que no colapse en Gazebo) -->
    <link name="world"></link>

    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Eslabón 0: Base del robot -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry><cylinder radius="0.1" length="0.1"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry><cylinder radius="0.1" length="0.1"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.1" radius="0.1">
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Articulación 1: Cintura (Revolución) -->
    <joint name="joint_1_waist" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/> <!-- Gira en Z -->
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- Eslabón 1 -->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder radius="0.05" length="0.3"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder radius="0.05" length="0.3"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.0" length="0.3" radius="0.05">
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Articulación 2: Hombro (Revolución) -->
    <joint name="joint_2_shoulder" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.3" rpy="0 1.5708 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- Eslabón 2 -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder radius="0.04" length="0.3"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder radius="0.04" length="0.3"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.8" length="0.3" radius="0.04">
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Articulación 3: Codo (Revolución) -->
    <joint name="joint_3_elbow" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- Eslabón 3 -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry><cylinder radius="0.03" length="0.2"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry><cylinder radius="0.03" length="0.2"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.2" radius="0.03">
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Articulación 4: Muñeca (Revolución) -->
    <joint name="joint_4_wrist" type="revolute">
        <parent link="link_3"/>
        <child link="end_effector"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- Efector Final (Caja representando un gripper base) -->
    <link name="end_effector">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry><box size="0.05 0.1 0.1"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry><box size="0.05 0.1 0.1"/></geometry>
        </collision>
        <xacro:inertial_box mass="0.2" x="0.05" y="0.1" z="0.1">
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

</robot>
